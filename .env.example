# ==============================================================================
# Aviation Monitoring & Analytics Platform — Environment Variables Template
# ==============================================================================
# SALIN FILE INI MENJADI '.env' UNTUK PENGEMBANGAN LOKAL.
# JANGAN PERNAH MENYIMPAN KREDENSIAL PRODUKSI ATAU API KEY NYATA DI DALAM FILE CONTOH INI.

# Lingkungan aplikasi: 'development' | 'testing' | 'production'
APP_ENV=development
APP_NAME="Aviation Monitoring & Analytics Platform"
DEBUG=true

# Mode provider data penerbangan:
# - 'mock': Menggunakan MockFlightProvider dengan dataset fixture lokal (tidak memerlukan API key).
# - 'aviationstack': Menggunakan Aviationstack API resmi (wajib mengisi AVIATIONSTACK_API_KEY).
# Catatan: Di production ('APP_ENV=production'), mode 'mock' akan otomatis ditolak saat startup.
FLIGHT_PROVIDER=mock

# Aviationstack API Key (Hanya diperlukan jika FLIGHT_PROVIDER=aviationstack)
# Kunci ini SENSITIF dan HANYA dibaca oleh backend Python.
# JANGAN PERNAH menggunakan prefix NEXT_PUBLIC_ karena akan membocorkannya ke browser client.
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1
AVIATIONSTACK_TIMEOUT_SECONDS=10.0

# Database PostgreSQL (Gunakan asyncpg driver untuk SQLAlchemy 2.0 async engine)
POSTGRES_USER=aviation_user
POSTGRES_PASSWORD=aviation_password
POSTGRES_DB=aviation_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aviation_user:aviation_password@localhost:5432/aviation_db

# Cache & Rate Limiting (Redis 7 - Berjalan sebagai cache ephemeral in-memory)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Keamanan Otentikasi & JWT
# Buat string acak minimal 32 karakter untuk production (misal: 'openssl rand -hex 32')
JWT_SECRET=change_me_to_a_secure_random_string_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Konfigurasi Cookie (Transportasi token ke browser)
# HttpOnly=True mencegah akses token dari JavaScript (mitigasi XSS).
COOKIE_SECURE=false # Setel true pada production (HTTPS)
COOKIE_SAMESITE=lax

# Batas Rate Limiting (Token bucket)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_SEARCH_PER_MINUTE=20
RATE_LIMIT_REFRESH_PER_MINUTE=6

# CORS: Daftar origin frontend yang diizinkan melakukan request dengan cookie credentials
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Next.js Public Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000
