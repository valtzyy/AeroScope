# ==========================================
# Aviation Monitoring & Analytics Platform
# .gitignore
# ==========================================

# Environment variables & Secrets
# File .env berisi kunci rahasia (API Key, JWT Secret, DB Password).
# Sangat penting agar file ini tidak pernah masuk ke version control (Git).
.env
.env.local
.env.*.local
*.env

# Python & Virtual Environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# Database & Cache local artifacts
*.db
*.sqlite3
dump.rdb

# Node.js & Frontend build artifacts
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS specific files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
